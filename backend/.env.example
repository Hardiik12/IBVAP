# IBVAP Backend Environment Configuration

APP_NAME="IBVAP Backend API"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=True

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://ibvap:ibvap@localhost:5432/ibvap

# JWT Security Settings
JWT_SECRET_KEY=replace-with-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (Comma-separated origins or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
