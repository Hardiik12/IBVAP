# ==============================================================================
# IBVAP — Intelligent Border Video Analytics Platform Environment Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# NOTE: In production environments, generate strong, cryptographically secure secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=ibvap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here

# Local host connection string (when running FastAPI locally outside Docker):
DATABASE_URL=postgresql+psycopg://postgres:postgres_password_here@localhost:5432/ibvap

# Docker Compose internal connection string (injected automatically in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://postgres:postgres_password_here@postgres:5432/ibvap

# ------------------------------------------------------------------------------
# 2. Backend FastAPI Service Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=IBVAP Backend API
DEBUG=true
LOG_LEVEL=INFO

# JWT Authentication (HS256): Generate a secure 32+ character key
# e.g. openssl rand -hex 32
JWT_SECRET_KEY=replace-with-secure-random-secret-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage path for evidence snapshot images
EVIDENCE_ROOT=/app/data/evidence

# Whether to run canonical database seeder on startup
RUN_SEED=true

# ------------------------------------------------------------------------------
# 3. AI Computer Vision & Analytics Pipeline Configuration
# ------------------------------------------------------------------------------
# Backend URL (use http://backend:8000 in Docker, or http://localhost:8000 locally)
AI_BACKEND_URL=http://localhost:8000

# Service credentials for automated event dispatching
AI_USERNAME=operator_user
AI_PASSWORD=OperatorSecret123!

# Input video source type: WEBCAM, VIDEO_FILE, or SYNTHETIC
AI_SOURCE_TYPE=VIDEO_FILE
AI_VIDEO_PATH=data/videos/test/sample_test.mp4
AI_CAMERA_INDEX=0
AI_CAMERA_ID=e4b2d35c-8dfa-4fb4-81d0-1e5b128dc90e
AI_ZONE_ID=c1f77b99-1c0b-4ef8-bb6d-8bb9bd380a22
AI_DISPLAY_PREVIEW=false
AI_LOG_LEVEL=INFO

# Event Dispatch Resilience & Retries
AI_DISPATCH_TIMEOUT=5.0
AI_DISPATCH_RETRIES=3
AI_DISPATCH_QUEUE_SIZE=100

# Optional Model Checksum Verification (SHA-256): Fail-closed if configured
AI_MODEL_SHA256=

# ------------------------------------------------------------------------------
# 4. Frontend Dashboard Client Configuration
# ------------------------------------------------------------------------------
# Next.js browser-facing API and WebSocket gateway endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/events
