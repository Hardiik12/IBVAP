# ==============================================================================
# IBVAP — Intelligent Border Video Analytics Platform Environment Template
# ==============================================================================
# WARNING: All credentials in this file are for DEVELOPMENT / DEMO ONLY.
# Generate strong, random secrets for production deployments.

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_DB=ibvap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hardik12
# Local host connection (when running backend outside Docker):
DATABASE_URL=postgresql+psycopg://postgres:hardik12@localhost:5432/ibvap
# Docker compose connection (injected automatically in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://postgres:hardik12@postgres:5432/ibvap

# ------------------------------------------------------------------------------
# 2. Backend API Service Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=IBVAP Backend API
DEBUG=true
LOG_LEVEL=INFO
# JWT Security: REPLACE WITH SECURE RANDOM STRING IN PRODUCTION
JWT_SECRET_KEY=replace-with-secure-random-secret-for-dev-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EVIDENCE_ROOT=/app/data/evidence
RUN_SEED=true

# ------------------------------------------------------------------------------
# 3. AI Computer Vision & Analytics Pipeline Settings
# ------------------------------------------------------------------------------
# In Docker: use http://backend:8000. In Local mode: use http://localhost:8000
AI_BACKEND_URL=http://backend:8000
AI_USERNAME=operator_user
AI_PASSWORD=OperatorSecret123!
AI_SOURCE_TYPE=VIDEO_FILE
AI_VIDEO_PATH=/app/data/videos/test/sample_test.mp4
AI_CAMERA_INDEX=0
AI_CAMERA_ID=e4b2d35c-8dfa-4fb4-81d0-1e5b128dc90e
AI_ZONE_ID=c1f77b99-1c0b-4ef8-bb6d-8bb9bd380a22
AI_DISPLAY_PREVIEW=false
AI_LOG_LEVEL=INFO
AI_DISPATCH_TIMEOUT=5.0
AI_DISPATCH_RETRIES=3
AI_DISPATCH_QUEUE_SIZE=100
# Optional SHA-256 model checksum verification (fail-closed if configured)
AI_MODEL_SHA256=

# ------------------------------------------------------------------------------
# 4. Frontend Dashboard Browser Settings
# ------------------------------------------------------------------------------
# Note: In the user browser, these must point to host-accessible URLs (localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/events

